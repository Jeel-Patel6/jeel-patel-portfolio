# Server-side only — never expose these with a VITE_ prefix.
# Copy this file to `.env` (local) or add the variables in your host's dashboard.
#
# `npm run dev` and `npm run preview` load these three variables from `.env`
# into the server-side contact handler (see `contactApi()` in vite.config.ts).
# Restart the dev/preview server after editing `.env`.
# On Vercel, add the same variables under Project → Settings → Environment
# Variables, then redeploy.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified sender identity used in the "From" header. The domain must be
# verified in Resend. For quick testing you can use
# "Portfolio Contact <onboarding@resend.dev>", but Resend only delivers that
# sender to the account owner's own address.
CONTACT_FROM=Portfolio Contact <hello@your-verified-domain.com>

# Inbox that receives contact-form messages.
CONTACT_TO=jeelpatel611@gmail.com
